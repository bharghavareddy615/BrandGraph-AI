# =====================================================================
# BrandGraph AI Configuration
# =====================================================================

# Environment (development, testing, production)
BRANDGRAPH_ENV=development

# SQLite Database Location
BRANDGRAPH_DB_PATH=brandgraph.sqlite

# Optional AI Review Provider (openai, anthropic, gemini, or leave empty/disabled for deterministic offline mode)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=15

# Flag to enable/disable external AI network calls
ALLOW_EXTERNAL_AI_CALLS=false

# Demo / Synthetic Data Labeling
ENABLE_SYNTHETIC_DATA_BANNER=true
